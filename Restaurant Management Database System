create DATABASE RestaurantDBv4;
GO
use RestaurantDBv4;
GO
-- create tables
-- ==========================
-- Departments DONE
-- ==========================
CREATE TABLE Departments (
    DeptID INT PRIMARY KEY,
    deptname VARCHAR(100) NOT NULL,
    dept_manager VARCHAR(150),
    salary DECIMAL(12,2) NOT NULL
);
GO
-- ==========================
-- Employee DONE
-- ==========================
CREATE TABLE Employee (
    EmpID INT PRIMARY KEY,
    emp_name VARCHAR(150) NOT NULL,
    email VARCHAR(200),
    phone VARCHAR(30),
    hire_date DATE NOT NULL,
    address VARCHAR(300),
    is_manager BIT NOT NULL DEFAULT 0,
    DeptID INT NOT NULL,
    CONSTRAINT FK_Employee_Departments FOREIGN KEY (DeptID) REFERENCES Departments(DeptID)
);
GO
-- ==========================
-- Shifts DONE  
-- ==========================
CREATE TABLE Shifts (
    ShiftID varchar(50) PRIMARY KEY,
    shift_name VARCHAR(50) NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL
);
GO
-- ==========================
-- EmployeeShift (Many-to-Many) DONE
-- ==========================
CREATE TABLE EmployeeShift (
    WorkDate DATE NOT NULL,
    EmpID INT NOT NULL,
    ShiftID Varchar(50) NOT NULL,
    PRIMARY KEY (WorkDate, EmpID, ShiftID),
    CONSTRAINT FK_EmployeeShift_Employee FOREIGN KEY (EmpID) REFERENCES Employee(EmpID),
    CONSTRAINT FK_EmployeeShift_Shifts FOREIGN KEY (ShiftID) REFERENCES Shifts(ShiftID)
);
GO
-- ==========================
-- Customer DONE
-- ==========================
CREATE TABLE Customer (
    CustID INT PRIMARY KEY,
    cust_name VARCHAR(150) NOT NULL,
    phone VARCHAR(30),
    email VARCHAR(200),
    age INT CHECK (age > 0 AND age <= 120),
    gender VARCHAR(10) CHECK (gender IN ('M','F'))
);
GO
-- ==========================
-- TableInfo DONE
-- ==========================
CREATE TABLE TableInfo (
    TableID INT PRIMARY KEY,
    table_number varchar(50) NOT NULL,
    seating_capacity INT CHECK (seating_capacity > 0),
    location_area VARCHAR(100),
    table_status VARCHAR(50) DEFAULT 'Available',
    EmpID INT,
    CONSTRAINT FK_TableInfo_Employee FOREIGN KEY (EmpID) REFERENCES Employee(EmpID)
);
GO
-- ==========================
-- Reservation done
-- ==========================
CREATE TABLE Reservation (
    ReservationID INT PRIMARY KEY,
    reservation_date DATE NOT NULL,
    reservation_time TIME NOT NULL,
    party_size INT CHECK (party_size > 0),
    reservation_status VARCHAR(50) DEFAULT 'Confirmed',
    CustID INT,
    TableID INT,
    CONSTRAINT FK_Reservation_Customer FOREIGN KEY (CustID) REFERENCES Customer(CustID),
    CONSTRAINT FK_Reservation_TableInfo FOREIGN KEY (TableID) REFERENCES TableInfo(TableID)
);
GO
--DONE

CREATE TABLE Orders (
    OrderID INT PRIMARY KEY,
    order_date DATE NOT NULL,
    order_time TIME NOT NULL,
    order_type VARCHAR(50),
    payment_method VARCHAR(50),
    transaction_status VARCHAR(50),
    tax_amount DECIMAL(10,2),
    order_status VARCHAR(50),
    payment_time TIME,
    payment_date DATE,
    amount DECIMAL(12,2),
    CustID INT,
    TableID INT,
    CONSTRAINT FK_Order_Customer FOREIGN KEY (CustID) REFERENCES Customer(CustID),
    CONSTRAINT FK_Order_TableInfo FOREIGN KEY (TableID) REFERENCES TableInfo(TableID)
);
GO
-- ==========================
-- MenuItems DONE
-- ==========================
CREATE TABLE MenuItems (
    MenuItemID INT PRIMARY KEY,
    item_name VARCHAR(200) NOT NULL,
    descriptions VARCHAR(500),
    price DECIMAL(10,2) CHECK (price >= 0),
    category VARCHAR(100),
    comments VARCHAR(300),
    prep_time INT CHECK (prep_time >= 0),
    is_available BIT NOT NULL DEFAULT 1
);
GO
-- ==========================
-- OrderItem (Many-to-Many) done
-- ==========================
CREATE TABLE OrderItem (
    OrderID INT NOT NULL,
    MenuItemID INT NOT NULL,
    quantity INT CHECK (quantity > 0),
    unit_price DECIMAL(10,2) CHECK (unit_price >= 0),
    PRIMARY KEY (OrderID, MenuItemID),
    CONSTRAINT FK_OrderItem_Orders FOREIGN KEY (OrderID) REFERENCES Orders(OrderID),
    CONSTRAINT FK_OrderItem_MenuItems FOREIGN KEY (MenuItemID) REFERENCES MenuItems(MenuItemID)
);
GO
-- ==========================
-- Inventory Done
-- ==========================
CREATE TABLE Inventory (
    InventoryID INT PRIMARY KEY,
    item_name VARCHAR(200) NOT NULL,
    current_stock INT CHECK (current_stock >= 0),
    reorder_level INT CHECK (reorder_level >= 0),
    category VARCHAR(100),
    storage_location VARCHAR(200)
);
GO
-- ==========================
-- Ingredients (Many-to-Many) (issue)
-- ==========================
CREATE TABLE Ingredients (
    MenuItemID INT NOT NULL,
    InventoryID INT NOT NULL,
    quantity_required DECIMAL(10,3) CHECK (quantity_required > 0),
    PRIMARY KEY (MenuItemID, InventoryID),
    CONSTRAINT FK_Ingredients_MenuItems FOREIGN KEY (MenuItemID) REFERENCES MenuItems(MenuItemID),
    CONSTRAINT FK_Ingredients_Inventory FOREIGN KEY (InventoryID) REFERENCES Inventory(InventoryID)
);
GO
-- ==========================
-- Supplier done
-- ==========================
CREATE TABLE Supplier (
    SupplierID INT PRIMARY KEY,
    supplier_name VARCHAR(200) NOT NULL,
    contact_person VARCHAR(150),
    phone VARCHAR(30),
    email VARCHAR(200),
    address VARCHAR(300)
);
GO
-- ==========================
-- PurchaseOrder done
-- ==========================
CREATE TABLE PurchaseOrder (
    PurchaseID INT PRIMARY KEY,
    SupplierID INT NOT NULL,
    order_status VARCHAR(50) DEFAULT 'Pending',
    order_date DATE NOT NULL,
    CONSTRAINT FK_PurchaseOrder_Supplier FOREIGN KEY (SupplierID) REFERENCES Supplier(SupplierID)
);
GO
-- ==========================
-- PurchaseItem (Many-to-Many) Done
-- ==========================
CREATE TABLE PurchaseItem (
    PurchaseID INT NOT NULL,
    InventoryID INT NOT NULL,
    quantity_ordered INT CHECK (quantity_ordered > 0),
    unit_cost DECIMAL(12,2) CHECK (unit_cost >= 0),
    total_amount DECIMAL(12,2) CHECK (total_amount >= 0),
    PRIMARY KEY (PurchaseID, InventoryID),
    CONSTRAINT FK_PurchaseItem_PurchaseOrder FOREIGN KEY (PurchaseID) REFERENCES PurchaseOrder(PurchaseID),
    CONSTRAINT FK_PurchaseItem_Inventory FOREIGN KEY (InventoryID) REFERENCES Inventory(InventoryID)
);
GO


