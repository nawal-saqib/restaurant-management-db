-- 1. Most costly ingredient (works)
SELECT TOP 1 Inventory.item_name,
       SUM(PurchaseItem.quantity_ordered * PurchaseItem.unit_cost) AS TotalSpent
FROM PurchaseItem
JOIN Inventory ON PurchaseItem.InventoryID = Inventory.InventoryID
GROUP BY Inventory.item_name
ORDER BY TotalSpent DESC;
GO
-- 2.Menu Items That Use Ingredients Below Reorder Level
SELECT 
    mi.item_name AS menu_item,
    inv.item_name AS ingredient,
    inv.current_stock,
    inv.reorder_level
FROM Ingredients ing
JOIN MenuItems mi ON ing.MenuItemID = mi.MenuItemID
JOIN Inventory inv ON ing.InventoryID = inv.InventoryID
WHERE inv.current_stock < inv.reorder_level;
GO
-- 3. Most Popular Menu Items by Total Revenue
SELECT 
    m.item_name,
    SUM(oi.quantity) AS total_sold,
    SUM(oi.quantity * m.price) AS total_revenue
FROM MenuItems m
JOIN OrderItem oi ON m.MenuItemID = oi.MenuItemID
GROUP BY m.item_name
ORDER BY total_revenue DESC;
GO
-- 4. Suppliers linked to the MOST popular menu items
SELECT TOP 5 
    s.supplier_name,
    COUNT(DISTINCT ing.MenuItemID) AS MenuItemsUsingSupplier
FROM Supplier s
JOIN PurchaseOrder po ON s.SupplierID = po.SupplierID
JOIN PurchaseItem pi ON po.PurchaseID = pi.PurchaseID
JOIN Ingredients ing ON pi.InventoryID = ing.InventoryID 
GROUP BY s.supplier_name
ORDER BY MenuItemsUsingSupplier DESC;
GO
-- 5. Recently purchased ingredients never used in any order
SELECT DISTINCT Inventory.item_name
FROM PurchaseItem
JOIN Inventory ON PurchaseItem.InventoryID = Inventory.InventoryID
LEFT JOIN Ingredients ON Inventory.InventoryID = Ingredients.InventoryID
LEFT JOIN OrderItem ON Ingredients.MenuItemID = OrderItem.MenuItemID
WHERE PurchaseItem.PurchaseID IN (
        SELECT PurchaseOrder.PurchaseID
        FROM PurchaseOrder
        WHERE PurchaseOrder.order_date >= DATEADD(DAY, -30, GETDATE())
      )
  AND OrderItem.MenuItemID IS NULL;
GO
-- 6. Most ordered item during peak hours (7 PM  10 PM)
SELECT TOP 1
       m.MenuItemID,
       m.item_name,
       SUM(oi.quantity) AS TotalOrderedDuringPeak
FROM OrderItem AS oi
JOIN Orders AS o ON oi.OrderID = o.OrderID
JOIN MenuItems AS m ON oi.MenuItemID = m.MenuItemID
WHERE DATEPART(HOUR, o.order_time) BETWEEN 19 AND 22
GROUP BY m.MenuItemID, m.item_name
ORDER BY TotalOrderedDuringPeak DESC;
GO
-- 7. Ingredients used in the highest number of menu items  
SELECT TOP 1
    inv.item_name AS ingredient,
    COUNT(DISTINCT ing.MenuItemID) AS MenuItemsUsingIt
FROM Ingredients ing
JOIN Inventory inv ON ing.InventoryID = inv.InventoryID
GROUP BY inv.item_name
ORDER BY MenuItemsUsingIt DESC;
GO
-- 8. Supplier Spending Summary (Total Purchased per Supplier)
SELECT 
    s.SupplierID,
    s.supplier_name,
    SUM(pi.total_amount) AS total_spent
FROM PurchaseOrder po
JOIN Supplier s ON po.SupplierID = s.SupplierID
JOIN PurchaseItem pi ON po.PurchaseID = pi.PurchaseID
GROUP BY s.SupplierID, s.supplier_name
ORDER BY total_spent DESC;
GO
-- 9. Employee Performance  Number of Orders Served
 SELECT 
    e.EmpID,
    e.emp_name,
    COUNT(o.OrderID) AS orders_served
FROM Employee e
JOIN TableInfo t ON e.EmpID = t.EmpID     
JOIN Orders o ON t.TableID = o.TableID       
GROUP BY 
    e.EmpID,
    e.emp_name
ORDER BY orders_served DESC;
GO
-- 10. High-demand items connected to low-stock ingredients
SELECT DISTINCT Inventory.item_name,
       Inventory.current_stock,
       Inventory.reorder_level,
       MenuItems.item_name AS menu_item_name
FROM Inventory
JOIN Ingredients ON Inventory.InventoryID = Ingredients.InventoryID
JOIN MenuItems ON Ingredients.MenuItemID = MenuItems.MenuItemID
JOIN OrderItem ON MenuItems.MenuItemID = OrderItem.MenuItemID
WHERE Inventory.current_stock < Inventory.reorder_level;
GO
-- 11. Top 10 customers by total spending
SELECT TOP 10 Customer.CustID, Customer.cust_name,
       SUM(MenuItems.price * OrderItem.quantity) AS TotalSpent
FROM Customer
JOIN Orders ON Customer.CustID = Orders.CustID
JOIN OrderItem ON Orders.OrderID = OrderItem.OrderID
JOIN MenuItems ON OrderItem.MenuItemID = MenuItems.MenuItemID
GROUP BY Customer.CustID, Customer.cust_name
ORDER BY TotalSpent DESC;
GO
-- 12. Suppliers unused in last 90 days
SELECT s.supplier_name
FROM Supplier s
WHERE NOT EXISTS (
    SELECT 1
    FROM PurchaseOrder po
    WHERE po.SupplierID = s.SupplierID
      AND po.order_date >= DATEADD(DAY, -90, GETDATE())
);
GO
-- 13. Daily Sales Summary (Total Revenue Per Day)
SELECT 
    o.order_date,
    SUM(oi.quantity * m.price) AS total_revenue
FROM Orders o
JOIN OrderItem oi ON o.OrderID = oi.OrderID
JOIN MenuItems m ON oi.MenuItemID = m.MenuItemID
GROUP BY o.order_date
ORDER BY o.order_date;
GO
-- 14. Dead menu items (not ordered in 60 days)
SELECT MenuItems.item_name
FROM MenuItems
WHERE MenuItems.MenuItemID NOT IN (
        SELECT DISTINCT OrderItem.MenuItemID
        FROM OrderItem
        JOIN Orders ON OrderItem.OrderID = Orders.OrderID
        WHERE Orders.order_date >= DATEADD(DAY, -60, GETDATE())
      );
GO
-- 15. Tables generating the highest revenue
SELECT TOP 10
    t.TableID,
    SUM(oi.quantity * mi.price) AS total_revenue
FROM Orders o
JOIN TableInfo t ON o.TableID = t.TableID
JOIN OrderItem oi ON o.OrderID = oi.OrderID
JOIN MenuItems mi ON oi.MenuItemID = mi.MenuItemID
GROUP BY t.TableID
ORDER BY total_revenue DESC;
GO
